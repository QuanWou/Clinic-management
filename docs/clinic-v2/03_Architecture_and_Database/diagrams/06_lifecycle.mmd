stateDiagram-v2
  state Appointment {
    [*] --> pending_confirmation
    pending_confirmation --> pending_payment: deposit required
    pending_confirmation --> confirmed: no deposit
    pending_payment --> confirmed: verified and hold valid
    pending_payment --> cancelled: expired / failed
    confirmed --> checked_in: patient arrives
    confirmed --> cancelled: approved cancellation
    confirmed --> no_show: policy
    checked_in --> fulfilled: attendance recorded
  }
  state Encounter {
    [*] --> waiting
    waiting --> in_progress: assigned doctor starts
    in_progress --> awaiting_results: order pending
    awaiting_results --> in_progress: results reviewed
    in_progress --> clinically_completed: physician finalizes
    clinically_completed --> closed: closure policy
  }
  state Document {
    [*] --> draft
    draft --> validated
    validated --> signed: verified signer
    signed --> released: publish authorized
  }
  state Payment {
    [*] --> initiated
    initiated --> pending
    pending --> succeeded: verified provider / onsite receipt
    pending --> failed
    pending --> unknown: timeout
    unknown --> succeeded: reconciliation
    unknown --> failed: reconciliation
  }
